rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPublicTerm() {
      return resource.data.public == true;
    }

    function isPublicTranslation() {
      return resource.data.isPublic == true;
    }

    function isPublicSource() {
      return resource.data.public == true;
    }

    match /terms/{termSlug} {
      allow read: if isPublicTerm();
      allow write: if false;
    }

    match /translations/{translationId} {
      allow read: if isPublicTranslation();
      allow write: if false;
    }

    match /sources/{sourceId} {
      allow read: if isPublicSource();
      allow write: if false;
    }

    match /suggestions/{suggestionId} {
      allow read, write: if false;
    }

    match /moderation_events/{eventId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
