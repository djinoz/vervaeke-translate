# Trusted backend / local Node server only
# Copy to .env.backend.local for local backend secrets and server runtime config.
# Quoting rule: no quotes for simple values; use quotes only when the value contains spaces.
#
# Production Firebase Functions uses managed secret LOCAL_SUBMISSIONS_ADMIN_SECRET.
# Keep that value OUT of functions/.env; only non-secret runtime config belongs there.

LOCAL_SUBMISSIONS_PORT=8787
LOCAL_SUBMISSIONS_STORE_PATH=functions/.local-data/submissions.json
LOCAL_SUBMISSIONS_ADMIN_SECRET=replace-this-with-a-real-secret
LOCAL_SUBMISSIONS_EMAIL_MODE=stubbed
FIRESTORE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
