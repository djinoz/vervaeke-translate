{
  "name": "vervaeke-translate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:dev": "node functions/server.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "backend:test": "vitest run functions/submissionsBackend.test.ts",
    "preview": "vite preview",
    "corpus:add": "node scripts/corpus-tools.mjs add",
    "corpus:bundle": "node scripts/corpus-tools.mjs bundle",
    "corpus:diff": "node scripts/corpus-tools.mjs diff-live",
    "corpus:push": "node scripts/corpus-tools.mjs push-live",
    "corpus:pull": "node scripts/corpus-tools.mjs pull-live",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
